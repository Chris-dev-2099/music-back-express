// src/v1/routes/fileRoutes.js
import express from 'express'
import { listFiles, uploadFile, downloadFile, deleteFile } from '../../controllers/fileController.js'

const router = express.Router()

router.get('/', listFiles)
router.put('/:key', uploadFile)
router.get('/:key', downloadFile)
router.delete('/:key', deleteFile)

export default router  // ✅ NO module.exports