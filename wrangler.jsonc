{
  "name": "apimusic",
  "main": "src/index.js",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "JWT_SECRET": "dev-secret-change-in-prod",
    "RESEND_API_KEY": "",
    "DOMAIN": "http://localhost:8787"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "canciones",
      "preview_bucket_name": "canciones"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciafy",
      "database_id": "77d1dea6-2015-4b5f-b2ab-bb62580901e7"
    }
  ]
}